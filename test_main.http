GET http://127.0.0.1:8000/poems
Accept: application/json

###

GET http://127.0.0.1:8000/poems?author_id=3&limit=5&offset=0
Accept: application/json

###

GET http://127.0.0.1:8000/poems?author_name=李&limit=5&offset=0
Accept: application/json

###

GET http://127.0.0.1:8000/poems?collection_id=1&limit=5&offset=0
Accept: application/json

###

GET http://127.0.0.1:8000/poems?keyword=春&limit=5&offset=0
Accept: application/json

###

GET http://127.0.0.1:8000/poems?limit=3&offset=0
Accept: application/json

###

GET http://127.0.0.1:8000/poems/1
Accept: application/json

###

POST http://127.0.0.1:8000/poems
Content-Type: application/json

{
  "title": "黄鹤楼送孟浩然之广陵",
  "author_id": 1,
  "content": "故人西辞黄鹤楼，\n烟花三月下扬州。\n孤帆远影碧空尽，\n唯见长江天际流。"
}

###

PUT http://127.0.0.1:8000/poems/1
Content-Type: application/json

{
  "title": "静夜思",
  "author_id": 1,
  "content": "床前明月光，\n疑是地上霜。\n举头望明月，\n低头思故乡。"
}

###

PATCH http://127.0.0.1:8000/poems/1
Content-Type: application/json

{
  "author_id": 1,
  "content": "床前明月光，\n疑是地上霜。\n举头望明月，\n低头思故乡。"
}

